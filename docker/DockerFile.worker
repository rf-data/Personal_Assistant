FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    curl \
    tmux \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./

RUN uv sync \
    --frozen \
    --no-default-groups \
    --extra lecture-worker \
    --no-editable

COPY src ./src
COPY configuration ./configuration

# Runtime CLI closure shared with the existing C22/C26 deployment image.
COPY scripts/cs50_batch.py \
    scripts/cs50_worker.py \
    scripts/cs50_material_quality.py \
    scripts/deployment.py \
    scripts/cs50_materials.py \
    scripts/cs50_workflow.py \
    scripts/worker_image_smoke.py ./scripts/

# Import and argparse checks only: no jobs, downloads, credentials or mounts.
RUN --network=none /app/.venv/bin/python -B -m scripts.worker_image_smoke

CMD ["sleep", "infinity"]
