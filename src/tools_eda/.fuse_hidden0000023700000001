   "source": [
    "from src.data_import import scan_for_tables, f_path_list\n",
    "from src.paths import PATH_FALLDAUER\n",
    "\n",
    "# loading file paths\n",
    "dauer_files = f_path(PATH_DAUER)\n",
    "\n",
    "# scanning pdf files for certain keywords + saving results in dict\n",
    "keywords = [\"Übersicht gesetzliche Krankenversicherung\",\n",
    "            \"Arbeitsunfähigkeitsfälle und -tage der Pflichtmitglieder\",\n",
    "            \"AU-Fälle\", \"AU \", \"Diagnosen\"]\n",
    "\n",
    "range_dict = {}\n",
    "\n",
    "for i, f_path in enumerate(dauer_files):\n",
    "    pages = scan_for_tables(f_path, keywords=keywords, min_keyword_hits=2)\n",
    "    range_dict[f_path] = pages\n",
    "    print(f\"{i}:\\t{pages}\\n\")"
