   "source": [
    "## loading data from \"AU_Diagnosen\" files \n",
    "from src.data_import import extract_au_diagnosen\n",
    "from src.paths import PATH_DIAGNOSEN\n",
    "\n",
    "diag_files = f_path_list(PATH_DIAGNOSEN)   \n",
    "\n",
    "diag_dfs = []\n",
    "diag_dfs_group = []\n",
    "\n",
    "for f_path in diag_files:\n",
    "    # extracting year from file name\n",
    "    year_match = re.search(r\"(\\d{4})\", f_path)\n",
    "\n",
    "    if year_match:\n",
    "        year = year_match.group(1)\n",
    "    else:\n",
    "        year = pd.NA\n",
    "        print(\"Could not find year.\\n{f_path}\")\n",
    "\n",
    "    # extracting data from files and adding columns\n",
    "    df = extract_au_diagnosen(f\"{f_path}\")\n",
    "    df[\"source\"] = \"BMG_Diagnosen\"\n",
    "    df[\"Year\"] = year\n",
    "    df[\"Year\"] = pd.to_numeric(df[\"Year\"], errors=\"coerce\").astype(\"Int64\")\n",
    "\n",
    "    df[\"ICD_letter\"] = df[\"ICD\"].str[0]\n",
    "    df[\"ICD_description\"] = df[\"ICD_letter\"].map(ICD_LETTER_MAP)\n",
    "\n",
    "    # check for NaN values\n",
    "    if df.isna().sum().sum() > 0:\n",
    "        print(f\"NaNs detected in df_{year}:\\t{df.isna().sum().sum()}\")\n",
    "\n",
    "    # converting year to \"categotry\n",
    "    df[\"Year\"] = df[\"Year\"].astype(\"category\")\n",
    "    \n",
    "    # saving data as annually base dfs\n",
    "    try:   \n",
    "        df.to_parquet(os.path.join(DATA_DF_TRANSFORMED, f\"AU_Diagnosen_{year}.parquet\"))\n",
    "        print(f\"Saving df_{year} was successfully.\")\n",
    "    except Exception as e:\n",
    "        print(f\"When saving df_{year} an error of type {type(e).__name__} occurred:\\n{e}\")\n",
    "\n",
    "    # appending base dfs to list\n",
    "    diag_dfs.append(df)\n",
    "\n",
    "    # creating new dfs with grouped data (incl. mean or sum)\n",
    "    df_1 = df.groupby(\"ICD_letter\")[[\"Cases_F\", \"Cases_M\", \"Cases_T\",\n",
    "                                            \"Days_F\", \"Days_M\", \"Days_T\"]].sum().reset_index().copy()\n",
    "    \n",
    "    df_2 = df.groupby(\"ICD_letter\")[[\"Days_per_Case_F\", \"Days_per_Case_M\", \"Days_per_Case_T\"]].mean().reset_index().copy()\n",
    "   \n",
    "    df_group = pd.merge(df_1, df_2, on=\"ICD_letter\")\n",
    "    df_group[[\"Days_per_Case_F\", \"Days_per_Case_M\", \"Days_per_Case_T\"]] = \\\n",
    "    df_group[[\"Days_per_Case_F\", \"Days_per_Case_M\", \"Days_per_Case_T\"]].round(2)\n",
    "\n",
    "    df_group[\"ICD_description\"] = df_group[\"ICD_letter\"].map(ICD_LETTER_MAP)\n",
    "    df_group[\"source\"] = \"BMG_Diagnosen\"\n",
    "    df_group[\"Year\"] = year\n",
    "    df_group[\"Year\"] = df_group[\"Year\"].astype(\"category\")\n",
    "    \n",
    "    #  saving merged data as annually dfs\n",
    "    try:     \n",
    "        df_group.to_parquet(os.path.join(DATA_DF_TRANSFORMED, f\"AU_Diagnosen_grouped_{year}.parquet\"))\n",
    "        print(f\"Saving df_grouped_{year} was successfully.\")\n",
    "    except Exception as e:\n",
    "        print(f\"When saving df_grouped_{year} an error of type {type(e).__name__} occurred:\\n{e}\")\n",
    "\n",
    "    # appending grouped dfs to list\n",
    "    diag_dfs_group.append(df_group)\n",
    "    "
   ]
