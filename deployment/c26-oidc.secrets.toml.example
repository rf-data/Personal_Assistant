# Copy outside Git; UID 10001, mode 0600; blank fields intentionally fail startup.
[auth]
redirect_uri = "" # exact C26_UI_ORIGIN + /oauth2callback; registered at IdP
cookie_secret = "" # SECRET, independently supplied by operator; at least 32 chars
client_id = ""
client_secret = "" # SECRET, operator-managed
server_metadata_url = "" # verified HTTPS discovery URL, issuer must match
expose_tokens = []
[auth.client_kwargs]
scope = "openid"
# State, nonce and code exchange remain Streamlit/Authlib responsibilities.
