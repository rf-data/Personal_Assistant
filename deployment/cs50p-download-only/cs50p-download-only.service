[Unit]
Description=Manually approved CS50P download-only pilot (C26-CS50P-04)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cs50p-download
Group=cs50p-download
WorkingDirectory=/opt/cs50p-download-only/current/app
ExecStartPre=/opt/cs50p-download-only/current/venv/bin/python -m scripts.cs50p_download_only preflight
ExecStart=/opt/cs50p-download-only/current/venv/bin/python -m scripts.cs50p_download_only download
Environment=PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/var/cache/cs50p-download-only HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
UnsetEnvironment=OPENAI_API_KEY HF_API_KEY ANTHROPIC_API_KEY HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy SSL_CERT_FILE SSL_CERT_DIR PYTHONPATH PYTHONHOME
UMask=0077
CPUQuota=50%
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
LimitNOFILE=128
LimitCORE=0
LimitFSIZE=64M
TimeoutStartSec=600
TimeoutStopSec=30
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=32M
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/cs50p-download-only/archive /var/lib/cs50p-download-only/reports /var/cache/cs50p-download-only
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/var/lib/cs50p-mvp -/opt/cs50p
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cs50p-download-only
