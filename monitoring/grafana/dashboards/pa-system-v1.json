    {
      "id": 9,
      "title": "Container last seen (not Docker state)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pa-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "No data means absent observations or disabled discovery; never an inferred zero.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - container_last_seen{job=\"cAdvisor\",id!=\"/\"}",
          "legendFormat": "{{instance}} {{mountpoint}} {{device}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
