            "type": "string"
          },
          "job_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Job Id",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "activated",
              "already_active"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "parsed_version_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f]+$",
              "type": "string"
            },
            "title": "Parsed Version Ids",
