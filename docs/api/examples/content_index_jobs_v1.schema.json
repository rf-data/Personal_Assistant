          "phase": {
            "title": "Phase",
            "type": "string"
          },
          "process_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Process Id",
            "type": "string"
          },
          "progress": {
            "default": null,
            "title": "Progress",
            "type": "null"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Started At"
          },
          "status": {
            "enum": [
