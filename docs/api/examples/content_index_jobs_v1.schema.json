      "Job": {
        "additionalProperties": false,
        "properties": {
          "artifact_refs": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Artifact"
            },
            "maxItems": 1,
            "title": "Artifact Refs",
            "type": "array"
          },
