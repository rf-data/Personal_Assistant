            "type": "integer"
          },
          "selection_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Selection Sha256",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f]+$",
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          }
        },
        "required": [
          "input_ref",
          "course_id",
          "source_ids",
          "parsed_version_ids",
          "selection_sha256",
          "can_build"
        ],
        "title": "IndexInput",
        "type": "object"
