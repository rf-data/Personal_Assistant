        "items": {
          "$ref": "#/$defs/Job"
        },
        "maxItems": 20,
        "title": "Jobs",
        "type": "array"
      },
      "latest_activation": {
        "default": "undetermined",
        "enum": [
          "committed",
          "not_committed",
          "undetermined"
        ],
