        "type": "string"
      },
      "next_offset": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Next Offset"
      },
      "receipt": {
        "anyOf": [
          {
            "$ref": "#/$defs/IndexJobReceipt"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "retry_policy": {
        "const": "explicit_new_request_only",
        "default": "explicit_new_request_only",
        "title": "Retry Policy",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "state": {
        "enum": [
          "not_indexed",
          "active",
          "stale",
          "blocked",
          "failed",
          "building"
        ],
        "title": "State",
        "type": "string"
      }
    },
    "required": [
      "input",
      "state",
      "jobs"
    ],
    "title": "IndexStatus",
    "type": "object"
  }
}
