        "title": "Parsed Version Ids",
        "type": "array"
      },
      "record_count": {
        "maximum": 200000,
        "minimum": 0,
        "title": "Record Count",
        "type": "integer"
      },
      "record_set_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Record Set Sha256",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "selection_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Selection Sha256",
        "type": "string"
      },
      "source_ids": {
        "items": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "type": "string"
        },
        "title": "Source Ids",
        "type": "array"
      }
    },
    "required": [
      "job_id",
      "build_id",
      "outcome",
      "index_generation",
      "source_ids",
      "parsed_version_ids",
      "selection_sha256",
      "record_set_sha256",
      "record_count"
    ],
    "title": "IndexJobReceipt",
    "type": "object"
  },
  "IndexParams": {
    "additionalProperties": false,
    "properties": {
      "course_id": {
        "enum": [
          "cs50x",
          "cs50_python",
          "cs50_sql",
          "cs50_ai",
          "cs50_web",
          "cs50_cybersecurity"
        ],
        "title": "Course Id",
        "type": "string"
      },
      "output_name": {
        "default": "index-build",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "title": "Output Name",
        "type": "string"
      },
      "resume_of": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Resume Of"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "source_ref": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "title": "Source Ref",
        "type": "string"
      }
    },
    "required": [
      "source_ref",
      "course_id"
    ],
    "title": "IndexParams",
    "type": "object"
  },
