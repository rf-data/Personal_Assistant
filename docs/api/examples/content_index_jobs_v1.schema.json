{
  "IndexInput": {
    "additionalProperties": false,
    "properties": {
      "can_build": {
        "title": "Can Build",
        "type": "boolean"
      },
      "course_id": {
        "enum": [
          "cs50x",
          "cs50_python",
          "cs50_sql",
          "cs50_ai",
          "cs50_web",
          "cs50_cybersecurity"
        ],
        "title": "Course Id",
        "type": "string"
      },
      "input_ref": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "title": "Input Ref",
        "type": "string"
      },
      "parsed_version_ids": {
        "items": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "type": "string"
        },
        "title": "Parsed Version Ids",
        "type": "array"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "selection_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Selection Sha256",
        "type": "string"
      },
      "source_ids": {
        "items": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "type": "string"
        },
        "title": "Source Ids",
        "type": "array"
      }
    },
    "required": [
      "input_ref",
      "course_id",
      "source_ids",
      "parsed_version_ids",
      "selection_sha256",
      "can_build"
    ],
    "title": "IndexInput",
    "type": "object"
  },
  "IndexJobPlan": {
    "$defs": {
      "ContentReadSettings": {
        "additionalProperties": false,
        "properties": {
          "cursor_key_file": {
            "format": "path",
            "title": "Cursor Key File",
            "type": "string"
          },
          "root": {
            "format": "path",
            "title": "Root",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "root",
          "cursor_key_file"
        ],
        "title": "ContentReadSettings",
        "type": "object"
      },
      "IndexProjectionConfig": {
        "additionalProperties": false,
        "properties": {
          "boundary": {
            "const": "block",
            "default": "block",
            "title": "Boundary",
            "type": "string"
          },
          "chapter_context": {
            "const": "metadata_only",
            "default": "metadata_only",
            "title": "Chapter Context",
            "type": "string"
          },
          "empty_text": {
            "const": "reference_only",
            "default": "reference_only",
            "title": "Empty Text",
            "type": "string"
          },
          "max_codepoints": {
            "default": 2000,
            "maximum": 2000,
            "minimum": 1,
            "title": "Max Codepoints",
            "type": "integer"
          },
          "normalization": {
            "const": "none",
            "default": "none",
            "title": "Normalization",
            "type": "string"
          },
          "overlap_codepoints": {
            "default": 0,
            "enum": [
              0,
              128
            ],
            "title": "Overlap Codepoints",
            "type": "integer"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "selection": {
            "const": "content_primary_v1",
            "default": "content_primary_v1",
            "title": "Selection",
            "type": "string"
          }
        },
        "required": [
          "schema_version"
        ],
        "title": "IndexProjectionConfig",
        "type": "object"
      },
      "IndexSelection": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "$ref": "#/$defs/IndexProjectionConfig"
          },
          "parsed_version_ids": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f]+$",
              "type": "string"
            },
            "maxItems": 128,
            "title": "Parsed Version Ids",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "parsed_version_ids"
        ],
        "title": "IndexSelection",
        "type": "object"
      },
      "SearchSettings": {
        "additionalProperties": false,
        "properties": {
          "index_root": {
            "format": "path",
            "title": "Index Root",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "index_root"
        ],
        "title": "SearchSettings",
        "type": "object"
      },
      "VersionBinding": {
        "additionalProperties": false,
        "properties": {
          "parsed_version_id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "title": "Parsed Version Id",
            "type": "string"
          },
          "parser_config_id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "title": "Parser Config Id",
            "type": "string"
          },
          "payload_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Payload Sha256",
            "type": "string"
          },
          "projection_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Projection Sha256",
            "type": "string"
          },
          "source_id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "title": "Source Id",
            "type": "string"
          },
          "source_version_id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "title": "Source Version Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "source_version_id",
          "parsed_version_id",
          "parser_config_id",
          "payload_sha256",
          "projection_sha256"
        ],
        "title": "VersionBinding",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "content": {
        "$ref": "#/$defs/ContentReadSettings"
      },
      "course_id": {
        "enum": [
          "cs50x",
          "cs50_python",
          "cs50_sql",
          "cs50_ai",
          "cs50_web",
          "cs50_cybersecurity"
        ],
        "title": "Course Id",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "search": {
        "$ref": "#/$defs/SearchSettings"
      },
      "selection": {
        "$ref": "#/$defs/IndexSelection"
      },
      "versions": {
        "items": {
          "$ref": "#/$defs/VersionBinding"
        },
        "maxItems": 32,
        "minItems": 1,
        "title": "Versions",
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "course_id",
      "content",
      "search",
      "selection",
      "versions"
    ],
    "title": "IndexJobPlan",
    "type": "object"
  },
  "IndexJobReceipt": {
    "additionalProperties": false,
    "properties": {
      "build_id": {
        "pattern": "^[0-9a-f]{32}$",
