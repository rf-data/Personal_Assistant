        },
        "source_origin": {
          "default": "official",
          "enum": [
            "official",
            "synthetic"
          ],
          "title": "Source Origin",
          "type": "string"
        },
        "sources": {
          "maxProperties": 3,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,159}$": {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
