{
  "active_stage_contracts": {
    "lecture_material_handoff": {
      "inputs": [
        "quality",
        "plan",
        "normalized",
        "receipt",
        "raw"
      ],
      "outputs": [
        "handoff"
      ],
      "runner": "src.tools_lecture.material_handoff.prepare_material_handoff"
    },
    "local_material_import": {
      "inputs": [
        "plan",
        "local_raw"
      ],
      "outputs": [
        "raw",
        "receipt"
      ],
      "runner": "src.tools_materials.download.MaterialDownloader.obtain(local_file)"
    },
    "material_parsing": {
      "inputs": [
        "raw",
        "receipt"
      ],
      "outputs": [
        "raw",
        "receipt",
        "normalized"
      ],
      "runner": "src.tools_materials.processing.MaterialProcessor.parse"
    },
    "material_planning": {
      "inputs": [],
      "outputs": [
        "plan"
      ],
      "runner": "src.tools_materials.processing.make_plan"
    },
    "quality_evaluation": {
      "inputs": [
        "plan",
        "normalized",
        "receipt",
        "raw"
      ],
      "outputs": [
        "quality"
      ],
      "runner": "src.tools_lecture.material_handoff.prepare_material_handoff"
    }
  },
  "deferred_stage_contracts": {
    "audio_transcription": {
      "inputs": [
        "audio",
        "language"
      ],
      "outputs": [
        "TranscriptDocument"
      ],
      "reason": "No approved offline workflow execution",
      "runner": "src.tools_transcribe"
    },
    "formula_evaluation": {
      "inputs": [
        "independent_gold",
        "predictions"
      ],
      "outputs": [
        "MathEvaluationReport"
      ],
      "reason": "No material-to-gold binding; not automatically activated",
      "runner": "scripts.evaluate_math_formulas"
    },
    "knowledge_consolidation": {
      "inputs": [
        "knowledge",
        "evidence"
      ],
      "outputs": [
        "ConsolidatedKnowledgeDocument"
      ],
      "reason": "Separate bounded offline contract exists; not activated here",
      "runner": "src.tools_knowledge.consolidation_run"
    },
    "knowledge_extraction": {
      "inputs": [
        "transcript",
        "provenance"
      ],
      "outputs": [
        "LectureKnowledgeDocument"
      ],
      "reason": "Explicit later LLM approval required",
      "runner": "src.tools_knowledge.run_cs50_lecture"
    },
    "visual_enrichment": {
      "inputs": [
        "visual_inventory",
        "source_evidence"
      ],
      "outputs": [
        "visual_enrichment"
      ],
      "reason": "Provider and evidence approval required",
      "runner": "src.tools_knowledge.postprocess_visual.postprocess_visual_enrichment"
    }
  },
  "models": {
    "Definition": {
      "additionalProperties": false,
      "properties": {
        "continue_independent": {
          "default": true,
          "title": "Continue Independent",
          "type": "boolean"
        },
        "course_id": {
          "enum": [
            "cs50x",
            "cs50_python",
            "cs50_sql",
            "cs50_ai",
            "cs50_web",
            "cs50_cybersecurity"
