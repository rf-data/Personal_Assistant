{
  "additionalProperties": false,
  "properties": {
    "epoch": {
      "exclusiveMinimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "grant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Grant Id",
      "type": "string"
    },
    "mode": {
      "const": "inert",
      "default": "inert",
      "title": "Mode",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "uncertain"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "epoch",
    "plan_sha256",
    "grant_id",
    "status"
  ],
  "title": "DriverReceipt",
  "type": "object"
}
