      "default": "c26-gate-v2",
      "title": "Protocol",
      "type": "string"
    },
    "mode": {
      "const": "offline_fixture",
      "default": "offline_fixture",
      "title": "Mode",
      "type": "string"
    },
    "runtime_scope_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Scope Sha256",
      "type": "string"
    }
