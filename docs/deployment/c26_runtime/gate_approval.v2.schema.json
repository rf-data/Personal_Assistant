  "required": [
    "approval_id",
    "approved_by",
    "action",
    "plan_sha256",
    "approved_at",
    "expires_at",
    "confirmed",
    "runtime_scope_sha256"
  ],
  "title": "ApprovalV2",
  "type": "object"
