{
  "additionalProperties": false,
  "properties": {
    "epoch": {
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "expires_at": {
      "default": 0.0,
      "title": "Expires At",
      "type": "number"
    },
    "grant_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grant Id"
    },
    "grant_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grant Sha256"
    },
    "journal_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Journal Sha256",
      "type": "string"
    },
    "mode": {
      "const": "local_test_only",
      "default": "local_test_only",
      "title": "Mode",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "root_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Root Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "status": {
      "enum": [
        "held",
        "active",
        "claimed",
        "released"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "root_id",
    "revision",
    "epoch",
    "sequence",
    "journal_sha256",
    "status"
  ],
  "title": "Anchor",
  "type": "object"
}
