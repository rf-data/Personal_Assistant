@@ -1,5 +1,7 @@
 """Reuse the CS50 executor's hash, path, directory sync and receipt primitives."""
 
+import ctypes
+import errno
 import fcntl
 import os
 import tempfile
@@ -44,6 +46,9 @@ def locked(root):
 
 def publish_bytes(path, contents):
     """Exclusive atomic publication; an existing file is never replaced."""
+    destination = os.fsencode(path)
+    if b"\0" in destination:
+        raise ValueError("Invalid publication path")
     path.parent.mkdir(parents=True, exist_ok=True)
     fd, name = tempfile.mkstemp(prefix=".material-", dir=path.parent)
     try:
@@ -51,11 +56,38 @@ def publish_bytes(path, contents):
             stream.write(contents)
             stream.flush()
             os.fsync(stream.fileno())
-        os.link(name, path)
-        sync_directory(path.parent)
+        publish_file(Path(name), path)
     finally:
         Path(name).unlink(missing_ok=True)
 
 
+def publish_file(temporary, path):
+    """Same-filesystem atomic no-replace move; never adopt unknown leftovers."""
+    destination = os.fsencode(path)
+    if b"\0" in destination or b"\0" in os.fsencode(temporary):
+        raise ValueError("Invalid publication path")
+    # One atomic namespace operation: cancellation after link() previously
+    # left two names for the published inode until the finally block ran.
+    # SIGKILL cannot run finally; stopped-workspace inspection then correctly
+    # rejected that hardlink. Linux C16 requires no-replace rename semantics.
+    rename = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
+    if rename is None:
+        raise OSError(errno.ENOSYS, "Atomic no-replace publication unavailable")
+    rename.argtypes = [
+        ctypes.c_int,
+        ctypes.c_char_p,
+        ctypes.c_int,
+        ctypes.c_char_p,
+        ctypes.c_uint,
+    ]
+    rename.restype = ctypes.c_int
+    if rename(-100, os.fsencode(temporary), -100, destination, 1) != 0:
+        code = ctypes.get_errno()
+        raise OSError(code, "Atomic no-replace publication failed")
+    sync_directory(path.parent)
+    if temporary.parent != path.parent:
+        sync_directory(temporary.parent)
+
+
 def save_model(path, model):
     publish_bytes(path, (model.model_dump_json(indent=2) + "\n").encode())
diff --git a/src/tools_materials/text_validation.py b/src/tools_materials/text_validation.py
new file mode 100644
index 0000000000000000000000000000000000000000..4ceaa2739b7945acdcefb1d08fa100b63f52414f
--- /dev/null
+++ b/src/tools_materials/text_validation.py
@@ -0,0 +1,43 @@
+"""Content checks around the existing offline transcript importer; no worker."""
+
+from bs4 import BeautifulSoup
+
+from src.tools_lecture.execute_cs50 import validate_order
+from src.tools_transcribe.import_transcript import import_transcript
+
+
+def validate_html_page(path):
+    main = BeautifulSoup(path.read_bytes(), "html.parser").find("main")
+    if main is None or main.find("h1") is None or not main.h1.get_text(strip=True):
+        raise ValueError("HTML material lacks main content/title")
+    title = main.h1.get_text(" ", strip=True).lower()
+    if title.startswith(("404", "403", "error", "access denied", "not found")):
+        raise ValueError("HTML error page is not course material")
+
+
+def validate_text_source(path, binding):
+    text = path.read_text(encoding="utf-8-sig")
+    lowered = text.lstrip().lower()
+    if lowered.startswith(
+        ("error:", "404 ", "403 ", "access denied", "not found", "forbidden")
+    ):
+        raise ValueError("Error response masquerading as transcript")
+    if any(marker in lowered for marker in ("<!doctype html", "<html", "<body")):
+        if binding.format != "html":
+            raise ValueError("HTML response masquerading as transcript")
+    if binding.format == "html":
+        soup = BeautifulSoup(text, "html.parser")
+        main = soup.select_one("main")
+        if main is None or len(main.get_text(" ", strip=True)) < 40:
+            raise ValueError("Empty or unusable HTML transcript")
+        return
+    document = import_transcript(
+        path,
+        language=binding.language or "en",
+        original_url=binding.original_url,
+        format=binding.format,
+    )
+    if len(document.text.strip()) < 20:
+        raise ValueError("Transcript text too short for content validation")
+    if binding.format in {"srt", "vtt"}:
+        validate_order(document)
